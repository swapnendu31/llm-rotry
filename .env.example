REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
DB_PATH=./keys.db

# Admin Dashboard & Keys Management Authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin

# API Proxy & Key Acquisition Authentication Key (passed via X-Auth-Key, X-API-Key, or Authorization: Bearer <key>)
AUTH_KEY=rotator_secret_key_123


# Outbound Proxy Routes (3-Route Rotation: 1st=Direct/Own IP, 2nd=Route 1, 3rd=Route 2)
ROUTE_1_PROXY=socks5://127.0.0.1:1081
ROUTE_2_PROXY=socks5://127.0.0.1:1082